# Owner connection (migrations). Local Postgres or Neon DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev
# Password for the restricted app_rw role (created by migrations; NOBYPASSRLS).
APP_DB_PASSWORD=change-me
# Optional: explicit app_rw URL (otherwise derived from DATABASE_URL + APP_DB_PASSWORD).
# APP_DATABASE_URL=
DEMO_MODE=true
# >= 32 chars. Signs the local session cookie when Neon Auth isn't configured.
AUTH_LOCAL_SECRET=
# >= 32 chars. Derives demo persona passwords.
DEMO_PERSONA_SECRET=
# Neon Auth (optional locally)
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
